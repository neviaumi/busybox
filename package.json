{
  "author": "David Ng <david.ng.dev@gmail.com>",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@eslint/config-inspector": "1.4.2",
    "eslint": "9.39.2",
    "globals": "17.2.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lerna": "9.0.3",
    "lint-staged": "16.2.7",
    "pinst": "3.0.0",
    "prettier": "3.8.1"
  },
  "engines": {
    "node": ">=20",
    "yarn": "Use npm"
  },
